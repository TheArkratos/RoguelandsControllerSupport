<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
    <NuGetAudit>false</NuGetAudit>
    <!-- Stub fields intentionally model Unity's mutable runtime state. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/SelectionCornerStyle.cs" Link="SelectionCornerStyle.cs" />
    <Compile Include="../../src/ControllerFrontEndMenus.cs" Link="ControllerFrontEndMenus.cs" />
    <Compile Include="../../src/BindingConfig.cs" Link="BindingConfig.cs" />
    <Compile Include="../../src/JoystickInputState.cs" Link="JoystickInputState.cs" />
    <Compile Include="../../src/RawJoystickEvent.cs" Link="RawJoystickEvent.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Stubs.cs" />
  </ItemGroup>
</Project>
