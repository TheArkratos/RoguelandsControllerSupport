<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><RequiresRoguelandsReference>true</RequiresRoguelandsReference>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(RoguelandsManagedDir)/0Harmony.dll</HintPath>
    </Reference>
    <Compile Include="$(RoguelandsReferenceDir)/Assembly-CSharp/CameraScript.cs" Link="CameraScript.cs" />
    <Compile Include="../../src/ControllerAim.cs" Link="ControllerAim.cs" />
    <Compile Include="../../src/CameraAimPatches.cs" Link="CameraAimPatches.cs" />
    <Compile Include="../../src/JoystickInputState.cs" Link="JoystickInputState.cs" />
    <Compile Include="../../src/RawJoystickEvent.cs" Link="RawJoystickEvent.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Stubs.cs" />
  </ItemGroup>
</Project>
