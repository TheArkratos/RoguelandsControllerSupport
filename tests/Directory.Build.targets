<Project>
  <!-- These fixtures compile production source directly. Share the real policy,
       while keeping the legacy positive-fixture default explicitly test-only. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../src/ControllerInputOwnership.cs" Link="ControllerInputOwnership.cs" />
